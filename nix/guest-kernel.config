# What the guest kernel needs on top of arm64 defconfig. kernel-config-check.sh
# enforces every line against the final .config, so a symbol that loses its
# dependencies fails the build rather than the first boot.

# One file to boot: no modules, no initramfs.
CONFIG_MODULES=n
CONFIG_BLK_DEV_INITRD=n

# 4K guest pages on the 16K host, as every other Linux the orb's tools expect.
CONFIG_ARM64_4K_PAGES=y

# Cloud Hypervisor's devices, on a PCI bus behind a device-tree host bridge.
CONFIG_PCI=y
CONFIG_PCI_HOST_GENERIC=y
CONFIG_VIRTIO=y
CONFIG_VIRTIO_PCI=y
CONFIG_VIRTIO_BLK=y
CONFIG_VIRTIO_NET=y
CONFIG_VIRTIO_BALLOON=y
CONFIG_PAGE_REPORTING=y
CONFIG_HW_RANDOM=y
CONFIG_HW_RANDOM_VIRTIO=y

CONFIG_EXT4_FS=y
CONFIG_TMPFS=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_UNIX98_PTYS=y

# eth0 from the ip= cmdline, with the resolvers left in /proc/net/pnp.
CONFIG_IP_PNP=y

# console=ttyAMA0, which reaches the host's journal.
CONFIG_SERIAL_AMBA_PL011=y
CONFIG_SERIAL_AMBA_PL011_CONSOLE=y

# The clock, from the platform RTC at boot.
CONFIG_RTC_CLASS=y
CONFIG_RTC_HCTOSYS=y
CONFIG_RTC_DRV_PL031=y
