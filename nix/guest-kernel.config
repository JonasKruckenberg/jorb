# What every jorb guest kernel needs, whatever the host's architecture.
#
# Every line here is enforced against the final .config by
# kernel-config-check.sh, so a symbol that silently loses its dependencies
# fails the build rather than the first boot.

# One file to boot: no modules to load and no initramfs to assemble.
CONFIG_MODULES=n
CONFIG_BLK_DEV_INITRD=n

# Cloud Hypervisor puts its devices on a PCI bus.
CONFIG_PCI=y
CONFIG_VIRTIO=y
CONFIG_VIRTIO_PCI=y
CONFIG_VIRTIO_BLK=y
CONFIG_VIRTIO_NET=y

# The balloon reports freed guest pages back to the host.
CONFIG_VIRTIO_BALLOON=y
CONFIG_PAGE_REPORTING=y
CONFIG_HW_RANDOM=y
CONFIG_HW_RANDOM_VIRTIO=y

# Root is ext4 on /dev/vda, mounted without an initramfs.
CONFIG_EXT4_FS=y
CONFIG_TMPFS=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_UNIX98_PTYS=y

# The kernel configures eth0 from the ip= cmdline and leaves the result in
# /proc/net/pnp, which jorb-init copies to /etc/resolv.conf.
CONFIG_IP_PNP=y

# The guest clock comes from the platform RTC at boot; the driver is
# per-architecture.
CONFIG_RTC_CLASS=y
CONFIG_RTC_HCTOSYS=y
