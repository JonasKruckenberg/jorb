# The x86_64 half of the guest kernel's specification. x86_64 is 4K-paged
# already, so there is no page size option to set.

# Cloud Hypervisor boots an x86_64 guest through the PVH entry point of an
# uncompressed vmlinux, which is what this option adds.
CONFIG_HYPERVISOR_GUEST=y
CONFIG_PVH=y

# x86_64 guests get their PCI bus and their RTC from ACPI tables the VMM
# writes.
CONFIG_ACPI=y
CONFIG_PCI_MMCONFIG=y

# console=ttyS0 reaches the host's journal through this port.
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y

CONFIG_RTC_DRV_CMOS=y
