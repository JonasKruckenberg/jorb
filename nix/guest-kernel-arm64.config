# The arm64 half of the guest kernel's specification.

# The host runs 16K pages; the guest does not have to, and 4K keeps the guest
# page size the same as every other Linux the orb's tools expect.
CONFIG_ARM64_4K_PAGES=y

# aarch64 guests get a generic PCI host bridge from the device tree.
CONFIG_PCI_HOST_GENERIC=y

# console=ttyAMA0 reaches the host's journal through this port.
CONFIG_SERIAL_AMBA_PL011=y
CONFIG_SERIAL_AMBA_PL011_CONSOLE=y

CONFIG_RTC_DRV_PL031=y
