// jorb's own Alloy file, beside the owner's: cgroup metrics for the orbs,
// labelled by orb. ASSUMES A11 (G7 checks it).
//
// docker_only turns off every raw cgroup but the root, the allowlist brings
// jorb.slice back, and the root is turned off on its own.
prometheus.exporter.cadvisor "jorb" {
	store_container_labels      = false
	docker_only                 = true
	raw_cgroup_prefix_allowlist = ["/jorb.slice/"]
	disable_root_cgroup_stats   = true
}

prometheus.scrape "jorb" {
	targets         = prometheus.exporter.cadvisor.jorb.targets
	forward_to      = [prometheus.relabel.jorb.receiver]
	scrape_interval = "15s"
	job_name        = "jorb"
}

prometheus.relabel "jorb" {
	forward_to = [prometheus.remote_write.jorb.receiver]

	// /jorb.slice/jorb-orb-amp-1.service becomes orb="amp-1".
	rule {
		action        = "replace"
		source_labels = ["id"]
		regex         = "/jorb\\.slice/jorb-orb-(.+)\\.service"
		target_label  = "orb"
		replacement   = "$1"
	}

	rule {
		action = "labeldrop"
		regex  = "name"
	}
}

prometheus.remote_write "jorb" {
	endpoint {
		url = "@JORB_METRICS_ENDPOINT@"
	}
}
